# ---- required ----
# Required when LLM_PROVIDER=openai:
OPENAI_API_KEY=sk-...
# For Groq instead, set LLM_PROVIDER=groq and provide GROQ_API_KEY.
# GROQ_API_KEY=gsk_...

# ---- LLM ----
LLM_PROVIDER=openai           # openai or groq
LLM_MODEL=gpt-4.1
LLM_MAX_OUTPUT_TOKENS=800
IMAGE_DETAIL=auto            # low = cheaper image tokens

# ---- chunking (CLIP tokens; CLIP's hard limit is 77) ----
CHUNK_SIZE_TOKENS=60
CHUNK_OVERLAP_TOKENS=12
CONTEXT_WINDOW_CHUNKS=2      # LLM sees the matched chunk +/- 2 neighbours

# ---- retrieval ----
TOP_K_TEXT=5
TOP_K_IMAGES=2
MIN_SCORE_TEXT=0.25
MIN_SCORE_IMAGE=0.18

# ---- ingestion ----
DATA_DIR=data                # inbox/ images/ rag.db live here (mount a volume in prod)
SCAN_INTERVAL_SECONDS=60     # 0 = scan once at startup
ALLOW_UPLOADS=true
MAX_FILE_MB=50

# ---- guardrails ----
MAX_QUERY_CHARS=1000
MODERATION_ENABLED=true
RATE_LIMIT_PER_MINUTE=20
REDACT_CONTACT_INFO=false    # true = also mask emails/phones in answers

# ---- optional login for the UI (set all three to enable) ----
# APP_USERNAME=admin
# APP_PASSWORD=change-me
# CHAINLIT_AUTH_SECRET=      # generate with: chainlit create-secret

LOG_LEVEL=INFO
